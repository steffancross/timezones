# Machine slug for this site, kebab-case. Used as the `site` super-property on
# all PostHog events. Must match `vars.NEXT_PUBLIC_SITE_ID` in wrangler.jsonc.
NEXT_PUBLIC_SITE_ID=site-template

# Human-readable display name. Used in <title>, OG tags, header/footer brand.
# Must match `vars.NEXT_PUBLIC_SITE_NAME` in wrangler.jsonc.
NEXT_PUBLIC_SITE_NAME=Site Template

# PostHog project token. Starts with `phc_`.
# Get from PostHog → Settings → Project → API Key.
NEXT_PUBLIC_POSTHOG_KEY=phc_xxx

# Production base URL. Used for canonical tags, sitemap, OG tags.
# Local dev: http://localhost:3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000
