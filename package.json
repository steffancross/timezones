{
  "name": "site-template",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "next dev",
    "data:cities": "tsx scripts/build-cities/run.ts",
    "data:search": "tsx scripts/build-search-index.ts",
    "data:build": "pnpm data:cities && pnpm data:search",
    "build": "pnpm data:build && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "ci": "pnpm typecheck && pnpm lint && pnpm test && pnpm test:e2e",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv worker-configuration.d.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.19.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "luxon": "^3.7.2",
    "minisearch": "^7.2.0",
    "next": "^16.2.0",
    "posthog-js": "^1.374.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "suncalc": "^1.9.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^3.24.0",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/adm-zip": "^0.5.8",
    "@types/luxon": "^3.7.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/suncalc": "^1.9.2",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/browser": "^4.1.6",
    "@vitest/browser-playwright": "^4.1.6",
    "adm-zip": "^0.5.17",
    "csv-parse": "^6.2.1",
    "playwright": "^1.60.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.22.2",
    "typescript": "^5.7.0",
    "vitest": "^4.1.6",
    "vitest-browser-react": "^2.2.0",
    "wrangler": "^4.92.0"
  }
}
