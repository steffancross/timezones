{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "worldtimezones",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-05-14",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true },
  "vars": {
    "NEXT_PUBLIC_SITE_ID": "worldtimezones",
    "NEXT_PUBLIC_SITE_NAME": "World Timezones",
    "NEXT_PUBLIC_BASE_URL": "https://worldtimezones.net"
  },
  // Incremental cache store (writable). open-next.config.ts uses r2-incremental-cache + a regional
  // cache; the binding name `NEXT_INC_CACHE_R2_BUCKET` is the convention that override reads. The
  // bucket needs an object-lifecycle rule to reap orphaned old-build entries (keys are namespaced
  // by build id). Window must exceed the deploy gap: 7d during frequent post-launch deploys, raise
  // toward 30d as cadence slows. The old NEXT_INC_CACHE_KV namespace (id
  // 64ee64b10cc84224a72dcc338b04a2b7) is unbound and unused; delete it once R2 is verified.
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "worldtimezones-incremental-cache"
    }
  ],
  // Availability Room store (spec 1) — the app's first database. Local dev and
  // tests auto-provision their own D1 (.wrangler/state and in-memory workerd);
  // only this remote one must be created once via `wrangler d1 create
  // worldtimezones-rooms`, whose printed database_id replaces the placeholder
  // below. Apply schema: `wrangler d1 migrations apply worldtimezones-rooms
  // --local` (dev) / `--remote` (prod).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "worldtimezones-rooms",
      "database_id": "72edecc3-6b56-4700-9a30-6cce15102d8f",
      "migrations_dir": "migrations"
    }
  ],
  // Rate limiter for the claim endpoint (spec 2) — the one password-guessing
  // surface. Keyed per (room, IP) in the handler: 5 attempts / 60s. The native
  // binding isn't modeled by Miniflare, so integration tests inject a fake
  // limiter and never touch this. namespace_id is an arbitrary per-account id.
  "ratelimits": [
    {
      "name": "CLAIM_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    },
    // Room creation (spec 7c) — the one public write nothing else guards. Keyed
    // per IP in the handler. Same Miniflare caveat as CLAIM_LIMITER: tests/local
    // fall back to allow-all. namespace_id is an arbitrary per-account id.
    {
      "name": "ROOM_CREATE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 10, "period": 60 }
    }
  ]
}
